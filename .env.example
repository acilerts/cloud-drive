# MongoDB
MONGO_PORT=27017
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=PROMENI_LOZINKU
MONGO_URI=mongodb://admin:PROMENI_LOZINKU@mongo:27017/?authSource=admin

# MinIO (object store)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=PROMENI_LOZINKU

# Mailpit (local SMTP + web mail preview)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@cloud-drive.local

# API Gateway
GATEWAY_PORT=8080
USERS_SERVICE_URL=http://users:8081
FILES_SERVICE_URL=http://files:8082
NOTIFICATIONS_SERVICE_URL=http://notifications:8084

# Users service
USERS_PORT=8081
CLIENT_BASE_URL=http://localhost:8080
DEFAULT_QUOTA_BYTES=1073741824
CONFIRM_TTL=24h

# Files service
FILES_PORT=8082
FILES_MONGO_DB=files

# Login
JWT_TTL=30m
OTP_TTL=5m
PASSWORD_MAX_AGE=1440h
MAX_LOGIN_FAILURES=5
LOCKOUT_DURATION=15m

# Account Recovery
PASSWORD_MIN_AGE=10s
RESET_TTL=15m
MAGIC_TTL=10m

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=PROMENI_LOZINKU

# Quota
QUOTA_MAX_BYTES=107374182400    # 100GB je maksimum

INTERNAL_API_TOKEN= # 32 karaktera minimum - u .env se upisuje stvarna vrednost