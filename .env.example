# MongoDB
MONGO_PORT = 27017
MONGO_ROOT_USER = admin
MONGO_ROOT_PASSWORD = PROMENI_LOZINKU # moja greska je sto sam u drugom commitu stavio istu lozinku u .env.example i u moj licni .env koji je u .gitignore - u svom .env fajlu svako stavlja svoju lozinku, a .env.example je samo primer

# MinIO (object store)
MINIO_API_PORT = 9000
MINIO_CONSOLE_PORT = 9001
MINIO_ROOT_USER = minioadmin
MINIO_ROOT_PASSWORD = PROMENI_LOZINKU # moja greska je sto sam u drugom commitu stavio istu lozinku u .env.example i u moj licni .env koji je u .gitignore - u svom .env fajlu svako stavlja svoju lozinku, a .env.example je samo primer

# Mailpit (local SMTP + web mail preview)
MAILPIT_SMTP_PORT = 1025
MAILPIT_UI_PORT = 8025

# API Gateway
GATEWAY_PORT = 8080

# Users service
USERS_PORT = 8081
CLIENT_BASE_URL=http://localhost:8080
DEFAULT_QUOTA_BYTES=1073741824
CONFIRM_TTL=24h

# Login
JWT_TTL=30m
OTP_TTL=5m
PASSWORD_MAX_AGE=1440h
MAX_LOGIN_FAILURES=5
LOCKOUT_DURATION=15m
